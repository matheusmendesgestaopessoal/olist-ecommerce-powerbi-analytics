{
  "name": "Matheus Mendes · Identidade",
  "dataColors": [
    "#1A6BF5",
    "#5AB0FF",
    "#0F4FD1",
    "#FFD93D",
    "#00D980",
    "#FF3B3B",
    "#CFE0FF",
    "#5E5E5E"
  ],
  "background": "#FFFFFF",
  "foreground": "#111111",
  "tableAccent": "#1A6BF5",
  "good": "#00D980",
  "neutral": "#FFD93D",
  "bad": "#FF3B3B",
  "maximum": "#1A6BF5",
  "center": "#5AB0FF",
  "minimum": "#CFE0FF",
  "hyperlink": "#0F4FD1",
  "visitedHyperlink": "#0F4FD1",
  "textClasses": {
    "callout": { "fontSize": 28, "fontFace": "Segoe UI Bold", "color": "#111111" },
    "title":   { "fontSize": 13, "fontFace": "Segoe UI Semibold", "color": "#111111" },
    "header":  { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#111111" },
    "label":   { "fontSize": 10, "fontFace": "Segoe UI", "color": "#5E5E5E" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#ECECEA" } }, "radius": 16 }],
        "dropShadow": [{ "show": false }],
        "padding": [{ "top": 16, "bottom": 16, "left": 16, "right": 16 }],
        "title": [{
          "show": true,
          "fontColor": { "solid": { "color": "#111111" } },
          "fontSize": 13,
          "fontFamily": "Segoe UI Semibold",
          "alignment": "left"
        }],
        "visualTooltip": [{
          "background": { "solid": { "color": "#1E1E1E" } },
          "titleFontColor": { "solid": { "color": "#FFFFFF" } },
          "valueFontColor": { "solid": { "color": "#FFFFFF" } }
        }],
        "categoryAxis": [{ "labelColor": { "solid": { "color": "#5E5E5E" } }, "fontSize": 10, "gridlineShow": false }],
        "valueAxis":    [{ "labelColor": { "solid": { "color": "#5E5E5E" } }, "fontSize": 10, "gridlineColor": { "solid": { "color": "#EFEFED" } } }],
        "legend":       [{ "labelColor": { "solid": { "color": "#5E5E5E" } }, "fontSize": 10, "position": "Top" }],
        "labels":       [{ "color": { "solid": { "color": "#111111" } }, "fontSize": 10 }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F7F8FA" } }, "transparency": 0 }],
        "outspace":   [{ "color": { "solid": { "color": "#F7F8FA" } }, "transparency": 0 }]
      }
    },
    "textbox": {
      "*": {
        "background": [{ "show": false }],
        "border": [{ "show": false }],
        "padding": [{ "top": 0, "bottom": 0, "left": 0, "right": 0 }]
      }
    },
    "shape":       { "*": { "background": [{ "show": false }], "border": [{ "show": false }] } },
    "image":       { "*": { "background": [{ "show": false }], "border": [{ "show": false }] } },
    "actionButton":{ "*": { "background": [{ "show": false }], "border": [{ "show": false }] } },
    "card": {
      "*": {
        "labels":         [{ "color": { "solid": { "color": "#111111" } }, "fontSize": 28, "fontFamily": "Segoe UI Bold" }],
        "categoryLabels": [{ "color": { "solid": { "color": "#5E5E5E" } }, "fontSize": 11, "fontFamily": "Segoe UI Semibold" }]
      }
    },
    "slicer": {
      "*": {
        "items":  [{ "fontColor": { "solid": { "color": "#111111" } }, "fontSize": 11 }],
        "header": [{ "fontColor": { "solid": { "color": "#5E5E5E" } }, "fontSize": 10, "fontFamily": "Segoe UI Semibold" }]
      }
    },
    "tableEx": {
      "*": {
        "grid":         [{ "gridHorizontalColor": { "solid": { "color": "#EFEFED" } }, "gridVertical": false, "rowPadding": 6 }],
        "columnHeaders":[{ "fontColor": { "solid": { "color": "#5E5E5E" } }, "backColor": { "solid": { "color": "#F7F8FA" } }, "fontFamily": "Segoe UI Semibold" }],
        "values":       [{ "fontColorPrimary": { "solid": { "color": "#111111" } }, "backColorPrimary": { "solid": { "color": "#FFFFFF" } }, "backColorSecondary": { "solid": { "color": "#FFFFFF" } } }]
      }
    }
  }
}
