	partition _Medidas = m
		mode: import
		source =
				let
				  Origem = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i45WMlSKjQUA", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Dummy = _t]),
				  #"Tipo de coluna alterado" = Table.TransformColumnTypes(Origem, {{"Dummy", Int64.Type}}),
				    #"Colunas Removidas" = Table.RemoveColumns(#"Tipo de coluna alterado",{"Dummy"})
				in
				  #"Colunas Removidas"

	annotation PBI_ResultType = Table

