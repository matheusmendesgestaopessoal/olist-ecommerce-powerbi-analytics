	measure 'Txt Ctx No Prazo' = "nota média · " & FORMAT ( [% Notas 1 No Prazo], "0.0%" ) & " de notas 1"
		displayFolder: 10 Textos
		lineageTag: 79cde4c3-bc47-4c5c-8a4a-aee535c6a23f

	measure 'Txt Ctx Atrasado' = "nota média · " & FORMAT ( [% Notas 1 Atrasado], "0%" ) & " de notas 1"
		displayFolder: 10 Textos
		lineageTag: c03bfb90-8b86-4206-af51-21d81ecb6e13

	measure 'Txt Postagem No Prazo' = FORMAT ( CALCULATE ( [Dias Postagem], ft_vendas[atrasado] = 0 ), "0.0" )
		displayFolder: 10 Textos
		lineageTag: f55cbcba-a345-4177-acb8-66a8b697f106

	measure 'Txt Postagem Atrasado' = FORMAT ( CALCULATE ( [Dias Postagem], ft_vendas[atrasado] = 1 ), "0.0" )
		displayFolder: 10 Textos
		lineageTag: 4361e5cd-5af7-48f8-aa87-8fc154808f46

	measure 'Txt Transporte No Prazo' = FORMAT ( CALCULATE ( [Dias Transporte], ft_vendas[atrasado] = 0 ), "0.0" )
		displayFolder: 10 Textos
		lineageTag: b0afe8d2-e7e9-4303-af4c-7ed6ed09d2e9

	measure 'Txt Transporte Atrasado' = FORMAT ( CALCULATE ( [Dias Transporte], ft_vendas[atrasado] = 1 ), "0.0" )
		displayFolder: 10 Textos
