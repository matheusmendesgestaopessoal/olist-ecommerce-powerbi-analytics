/// Todas as medidas do relatório. Pastas: 01 Base · 02 Nota · 03 Entrega · 04 Sellers e categorias ·
/// 05 Comparação com a rede · 10 Textos (títulos e números formatados) · 11 Cores (formatação condicional).
/// Medidas de pedido agrupam ft_vendas por order_id (o grão é pedido × seller × categoria).
table _Medidas
	lineageTag: bfcc991b-048d-43f0-87e9-9ee729a6f41e

	measure Faturamento = SUM ( ft_vendas[faturamento] )
		formatString: "R$ "#,0
		displayFolder: 01 Base
		lineageTag: edb7eebc-5bcc-4f3b-a0f7-0618adb1ef8c

	measure Pedidos = DISTINCTCOUNT ( ft_vendas[order_id] )
		formatString: #,0
		displayFolder: 01 Base
		lineageTag: dc853bf4-5d35-4e6a-8305-3176a696632a

	measure 'Nota Ajustada Seller' =
			VAR _n = [Pedidos Avaliados]
			VAR _m = 13.88
			VAR _media = CALCULATE ( [Nota Média], REMOVEFILTERS ( dm_seller ) )
			RETURN IF ( _n > 0, DIVIDE ( _n, _n + _m ) * [Nota Média] + DIVIDE ( _m, _n + _m ) * _media )
		formatString: 0.00
		displayFolder: 04 Sellers e categorias
		lineageTag: 3704a6c4-8247-4923-a66a-48975f945d0c

	measure 'Nota Ajustada Categoria' =
			VAR _n = [Pedidos Avaliados]
			VAR _m = 16.36
			VAR _media = CALCULATE ( [Nota Média], REMOVEFILTERS ( dm_categoria ) )
			RETURN IF ( _n > 0, DIVIDE ( _n, _n + _m ) * [Nota Média] + DIVIDE ( _m, _n + _m ) * _media )
		formatString: 0.00
		displayFolder: 04 Sellers e categorias
		lineageTag: 3a4179b0-fcd0-494b-9eff-43a627890c9c

	measure 'Pedidos Avaliados' =
			COUNTROWS (
			    FILTER ( SUMMARIZE ( ft_vendas, ft_vendas[order_id], ft_vendas[nota_pedido] ), NOT ISBLANK ( ft_vendas[nota_pedido] ) )
			)
		formatString: #,0
		displayFolder: 02 Nota
		lineageTag: 9accd83e-2a3c-45bd-a4c6-3c85f64ee884

	measure 'Faturamento Mi' = DIVIDE ( [Faturamento], 1000000 )
		formatString: #,0.0
		displayFolder: 01 Base
		lineageTag: e5c487f3-60bc-48d2-ac35-b0ab2b9bbe3a

	measure 'Faturamento mil' = DIVIDE ( [Faturamento], 1000 )
		formatString: #,0
		displayFolder: 01 Base
		lineageTag: 9e93371e-4423-4f5f-b867-753d5d3e1f63

	measure Itens = SUM ( ft_vendas[itens] )
		formatString: #,0
		displayFolder: 01 Base
		lineageTag: 4364594b-7e86-4a23-878b-41304be2738e

	measure 'Ticket Médio' = DIVIDE ( [Faturamento], [Pedidos] )
		formatString: "R$ "#,0
		displayFolder: 01 Base
		lineageTag: 967278b6-50a7-439c-a2ad-f5d63e079ffb

	measure Sellers = DISTINCTCOUNT ( ft_vendas[seller_id] )
		formatString: #,0
		displayFolder: 01 Base
		lineageTag: 192256f5-fae2-4006-be2a-d7f9ac6918c2

	measure 'Crescimento Mensal' =
			VAR _f17 = CALCULATE ( [Faturamento], REMOVEFILTERS ( dm_data ), dm_data[year] = 2017 )
			VAR _f18 = CALCULATE ( [Faturamento], REMOVEFILTERS ( dm_data ), dm_data[year] = 2018 )
			VAR _m17 = CALCULATE ( COUNTROWS ( SUMMARIZE ( ft_vendas, dm_data[year_month] ) ), REMOVEFILTERS ( dm_data ), dm_data[year] = 2017 )
			VAR _m18 = CALCULATE ( COUNTROWS ( SUMMARIZE ( ft_vendas, dm_data[year_month] ) ), REMOVEFILTERS ( dm_data ), dm_data[year] = 2018 )
			RETURN DIVIDE ( DIVIDE ( _f18, _m18 ), DIVIDE ( _f17, _m17 ) ) - 1
		formatString: +0%;-0%
		displayFolder: 01 Base
		lineageTag: d8774a7c-1b26-4795-927c-5d26eaae4011

	measure '% Faturamento Top 10%' =
			VAR _sellers = FILTER ( ALLSELECTED ( dm_seller[seller_id] ), [Faturamento] > 0 )
			VAR _top = TOPN ( ROUNDUP ( COUNTROWS ( _sellers ) * 0.10, 0 ), _sellers, [Faturamento], DESC )
			RETURN DIVIDE ( SUMX ( _top, [Faturamento] ), CALCULATE ( [Faturamento], ALLSELECTED ( dm_seller[seller_id] ) ) )
		formatString: 0%
		displayFolder: 01 Base
		lineageTag: 23f0f1a8-f768-4d08-9785-83e81f1590a3

	measure 'Nota Média' =
			AVERAGEX (
			    FILTER ( SUMMARIZE ( ft_vendas, ft_vendas[order_id], ft_vendas[nota_pedido] ), NOT ISBLANK ( ft_vendas[nota_pedido] ) ),
			    ft_vendas[nota_pedido]
			)
		formatString: 0.00
		displayFolder: 02 Nota
		lineageTag: 5de2a23f-d59a-4ecb-b2f0-3467cac3e9b6

	measure '% Notas 1' =
			VAR _p = FILTER ( SUMMARIZE ( ft_vendas, ft_vendas[order_id], ft_vendas[nota_pedido] ), NOT ISBLANK ( ft_vendas[nota_pedido] ) )
			RETURN DIVIDE ( COUNTROWS ( FILTER ( _p, ROUND ( ft_vendas[nota_pedido], 0 ) = 1 ) ) + 0, COUNTROWS ( _p ) )
		formatString: 0.0%
		displayFolder: 02 Nota
		lineageTag: 2616e254-5503-4392-b051-72505b4fc8e2

	measure 'Nota No Prazo' = CALCULATE ( [Nota Média], ft_vendas[atrasado] = 0 )
		formatString: 0.00
		displayFolder: 02 Nota
		lineageTag: 7180313f-e5eb-4c82-9876-0e9348820a72

	measure 'Nota Atrasado' = CALCULATE ( [Nota Média], ft_vendas[atrasado] = 1 )
		formatString: 0.00
		displayFolder: 02 Nota
		lineageTag: 323aec53-2891-46ee-bd99-b9ce5f6160d8

	measure '% Notas 1 No Prazo' = CALCULATE ( [% Notas 1], ft_vendas[atrasado] = 0 )
		formatString: 0.0%
		displayFolder: 02 Nota
		lineageTag: 36e346c4-0bcc-4518-9b50-1ca8b1d30706

	measure '% Notas 1 Atrasado' = CALCULATE ( [% Notas 1], ft_vendas[atrasado] = 1 )
		formatString: 0%
		displayFolder: 02 Nota
		lineageTag: ec2cf1e4-9029-4502-aec3-5e5780db7ddc

	measure '% Notas 1 de Atrasos' =
			VAR _p =
			    FILTER (
			        SUMMARIZE ( ft_vendas, ft_vendas[order_id], ft_vendas[nota_pedido], ft_vendas[atrasado] ),
			        NOT ISBLANK ( ft_vendas[atrasado] ) && ROUND ( ft_vendas[nota_pedido], 0 ) = 1
			    )
			RETURN DIVIDE ( COUNTROWS ( FILTER ( _p, ft_vendas[atrasado] = 1 ) ) + 0, COUNTROWS ( _p ) )
		formatString: 0%
		displayFolder: 02 Nota
		lineageTag: 19e26c2c-9c82-4558-85a1-9d88e2f8446e

	measure 'Pedidos Analisados' =
			COUNTROWS (
			    FILTER (
			        SUMMARIZE ( ft_vendas, ft_vendas[order_id], ft_vendas[nota_pedido], ft_vendas[atrasado] ),
			        NOT ISBLANK ( ft_vendas[nota_pedido] ) && NOT ISBLANK ( ft_vendas[atrasado] )
			    )
			)
		formatString: #,0
		displayFolder: 03 Entrega
		lineageTag: b2dfa1bf-06ce-44e0-8343-c4d449d574f5

	measure '% Atraso' =
			VAR _p =
			    FILTER (
			        SUMMARIZE ( ft_vendas, ft_vendas[order_id], ft_vendas[nota_pedido], ft_vendas[atrasado] ),
			        NOT ISBLANK ( ft_vendas[nota_pedido] ) && NOT ISBLANK ( ft_vendas[atrasado] )
			    )
			RETURN DIVIDE ( COUNTROWS ( FILTER ( _p, ft_vendas[atrasado] = 1 ) ) + 0, COUNTROWS ( _p ) )
		formatString: 0.0%
		displayFolder: 03 Entrega
		lineageTag: d9ef80c6-d163-4d2a-9f14-4d67e68e7656

	measure 'Prazo Médio' =
			AVERAGEX (
			    FILTER (
			        SUMMARIZE ( ft_vendas, ft_vendas[order_id], ft_vendas[nota_pedido], ft_vendas[prazo_entrega_dias] ),
			        NOT ISBLANK ( ft_vendas[nota_pedido] ) && NOT ISBLANK ( ft_vendas[prazo_entrega_dias] )
			    ),
			    ft_vendas[prazo_entrega_dias]
			)
		formatString: 0.0" dias"
		displayFolder: 03 Entrega
		lineageTag: 70667b6a-8156-4c3a-801b-4f2773991a0e

	measure 'Prazo Médio UF' = IF ( [Pedidos Analisados] >= 300, [Prazo Médio] )
		formatString: 0.0
		displayFolder: 03 Entrega
		lineageTag: 7feeb114-1e88-42b0-88ef-763df4451c73

	measure 'Nota da Faixa' = IF ( NOT ISBLANK ( SELECTEDVALUE ( ft_vendas[faixa_prazo] ) ), [Nota Média] )
		formatString: 0.00
		displayFolder: 03 Entrega
		lineageTag: 0769c90e-a54e-456d-b7fd-9660365cae02

	measure 'Nota da Faixa Seller' = IF ( NOT ISBLANK ( SELECTEDVALUE ( ft_vendas[faixa_prazo_seller] ) ), [Nota Média] )
		formatString: 0.00
		displayFolder: 03 Entrega
		lineageTag: f9f44f56-ca2d-411e-b4ef-994903fabb6a

	measure 'Dias Postagem' =
			AVERAGEX (
			    FILTER ( SUMMARIZE ( ft_vendas, ft_vendas[order_id], ft_vendas[dias_postagem] ), NOT ISBLANK ( ft_vendas[dias_postagem] ) ),
			    ft_vendas[dias_postagem]
			)
		formatString: 0.0
		displayFolder: 03 Entrega
		lineageTag: d7ced64b-53fb-4c74-8385-ee4ecf330e36

	measure 'Dias Transporte' =
			AVERAGEX (
			    FILTER ( SUMMARIZE ( ft_vendas, ft_vendas[order_id], ft_vendas[dias_transporte] ), NOT ISBLANK ( ft_vendas[dias_transporte] ) ),
			    ft_vendas[dias_transporte]
			)
		formatString: 0.0
		displayFolder: 03 Entrega
		lineageTag: a77575a0-ccb2-4979-9c1d-58cd8798307e

	measure '% Atrasos do Seller' =
			VAR _p =
			    FILTER (
			        SUMMARIZE ( ft_vendas, ft_vendas[order_id], ft_vendas[atrasado], ft_vendas[seller_postou_atrasado] ),
			        ft_vendas[atrasado] = 1
			    )
			RETURN DIVIDE ( COUNTROWS ( FILTER ( _p, ft_vendas[seller_postou_atrasado] = 1 ) ) + 0, COUNTROWS ( _p ) )
		formatString: 0%
		displayFolder: 03 Entrega
		lineageTag: a23a2207-9cd8-4a7d-8f46-a16b15a1d1e7

	measure '% Atrasos do Transporte' = IF ( NOT ISBLANK ( [% Atrasos do Seller] ), 1 - [% Atrasos do Seller] )
		formatString: 0%
		displayFolder: 03 Entrega
		lineageTag: d933fb72-ec6c-4ade-9465-d7106362e7e8

	measure 'Faturamento mil 30+' = IF ( [Pedidos Avaliados] >= 30, [Faturamento mil] )
		formatString: """R$ ""#,0"" mil"""
		displayFolder: 04 Sellers e categorias
		lineageTag: 9591eb26-0c7e-4672-ae26-fe3b229a42c7

	measure 'Nota Média do Grupo' =
			IF (
			    NOT ISBLANK ( SELECTEDVALUE ( dm_seller[Grupo Atraso Ordem] ) ),
			    AVERAGEX ( VALUES ( dm_seller[seller_id] ), [Nota Média] )
			)
		formatString: 0.00
		displayFolder: 04 Sellers e categorias
		lineageTag: 419d26ff-8ebf-422f-992c-f33d8a67a7c3

	measure 'Posição Faturamento' = IF ( [Faturamento] > 0, RANKX ( ALL ( dm_seller ), [Faturamento], , DESC ) )
		formatString: 0
		displayFolder: 04 Sellers e categorias
		lineageTag: 6ab31520-51af-407d-941d-16a2ea19b26b

	measure 'Campeã Faturamento' =
			VAR _c = TOPN ( 1, CALCULATETABLE ( VALUES ( dm_categoria[categoria] ), dm_categoria[ranking_eligible] = TRUE () ), [Faturamento], DESC )
			RETURN MAXX ( _c, dm_categoria[categoria] & " · R$ " & FORMAT ( [Faturamento mil], "#,0" ) & " mil" )
		displayFolder: 04 Sellers e categorias
		lineageTag: ae909d1c-0075-4de1-af3e-9b09f9fb6e27

	measure 'Campeã Itens' =
			VAR _c = TOPN ( 1, CALCULATETABLE ( VALUES ( dm_categoria[categoria] ), dm_categoria[ranking_eligible] = TRUE () ), [Itens], DESC )
			RETURN MAXX ( _c, dm_categoria[categoria] & " · " & FORMAT ( [Itens], "#,0" ) & " itens" )
		displayFolder: 04 Sellers e categorias
		lineageTag: d7bd3a6c-e4c1-4a53-a2df-e2ce4b25c9a7

	measure 'Campeã Nota' =
			VAR _elegiveis =
			    FILTER (
			        CALCULATETABLE ( VALUES ( dm_categoria[categoria] ), dm_categoria[ranking_eligible] = TRUE () ),
			        [Pedidos Avaliados] >= 30
			    )
			VAR _c = TOPN ( 1, _elegiveis, [Nota Ajustada Categoria], DESC )
			RETURN MAXX ( _c, dm_categoria[categoria] & " · " & FORMAT ( [Nota Ajustada Categoria], "0.00" ) )
		displayFolder: 04 Sellers e categorias
		lineageTag: 166ba400-0526-4952-a667-d43af61dc00b

	measure 'Ticket Médio Rede' = CALCULATE ( [Ticket Médio], REMOVEFILTERS ( dm_seller ) )
		formatString: "R$ "#,0
		displayFolder: 05 Rede
		lineageTag: fd4ede10-55e2-4199-90f2-c58ec1fcf454

	measure 'Nota Média Rede' = CALCULATE ( [Nota Média], REMOVEFILTERS ( dm_seller ) )
		formatString: 0.00
		displayFolder: 05 Rede
		lineageTag: 30afef62-8060-4aa7-abf1-05526131ed2a

	measure '% Atraso Rede' = CALCULATE ( [% Atraso], REMOVEFILTERS ( dm_seller ) )
		formatString: 0.0%
		displayFolder: 05 Rede
		lineageTag: 7a16d5a9-d337-40fa-8012-829a73240138

	measure 'Prazo Médio Rede' = CALCULATE ( [Prazo Médio], REMOVEFILTERS ( dm_seller ) )
		formatString: 0.0" dias"
		displayFolder: 05 Rede
		lineageTag: 8f07db72-11b6-443c-a332-ea776e9a92a4

	measure 'Sellers Rede' = CALCULATE ( [Sellers], REMOVEFILTERS ( dm_seller ) )
		formatString: #,0
		displayFolder: 05 Rede
		lineageTag: cedfd01f-a2f4-4a3c-991a-08e811f812b7

	measure 'Ticket vs Rede' = DIVIDE ( [Ticket Médio], [Ticket Médio Rede] ) - 1
		formatString: +0%;-0%
		displayFolder: 05 Rede
		lineageTag: b68e47dd-5dd4-43e7-bb54-0098396758b1

	measure 'Nota vs Rede' = [Nota Ajustada Seller] - [Nota Média Rede]
		formatString: +0.00;-0.00
		displayFolder: 05 Rede
		lineageTag: 1cb21ff8-0179-4c17-a539-dfcd211f33f1

	measure 'Atraso vs Rede' = [% Atraso] - [% Atraso Rede]
		formatString: +0.0%;-0.0%
		displayFolder: 05 Rede
		lineageTag: 3f0ccb7e-2534-4ecc-a588-d7c4245731b3

	measure 'Txt Resposta' =
			"Não. Faturamento e nota quase não se relacionam. O que decide a nota é a entrega: pedido atrasado recebe "
			    & FORMAT ( [Nota Atrasado], "0.00" ) & ", contra " & FORMAT ( [Nota No Prazo], "0.00" ) & " no prazo."
		displayFolder: 10 Textos
		lineageTag: 5e0d5379-f972-49ba-a333-173ada74fbd4

	measure 'Txt KPI Faturamento' =
			IF (
			    [Faturamento] >= 1000000,
			    "R$ " & FORMAT ( [Faturamento Mi], "0.00" ) & " Mi",
			    "R$ " & FORMAT ( [Faturamento mil], "#,0" ) & " mil"
			)
		displayFolder: 10 Textos
		lineageTag: 47efc0ab-08c6-435b-9792-5efd88d9de4a

	measure 'Txt Pill Crescimento' = FORMAT ( [Crescimento Mensal], "+0%;-0%" )
		displayFolder: 10 Textos
		lineageTag: 0b1139a7-034d-4e3d-8d0e-e57b1194280b

	measure 'Txt KPI Pedidos' = IF ( [Pedidos] >= 10000, FORMAT ( [Pedidos] / 1000, "#,0.0" ) & " mil", FORMAT ( [Pedidos], "#,0" ) )
		displayFolder: 10 Textos
		lineageTag: 6c887108-6397-44b9-8258-750e0da91779

	measure 'Txt Ctx Ticket' = "Ticket médio R$ " & FORMAT ( [Ticket Médio], "#,0" )
		displayFolder: 10 Textos
		lineageTag: 7a63939b-a324-41e6-8bd9-cd4cf9fe6644

	measure 'Txt KPI Nota' = FORMAT ( [Nota Média], "0.00" )
		displayFolder: 10 Textos
		lineageTag: 9a8805c9-11e4-45d2-92c6-46547f53e488

	measure 'Txt Pill Notas 1' = FORMAT ( [% Notas 1], "0.0%" )
		displayFolder: 10 Textos
		lineageTag: 4afdefd6-b566-4913-ad8e-5fd6ee578397

	measure 'Txt KPI Atraso' = FORMAT ( [% Atraso], "0.0%" )
		displayFolder: 10 Textos
		lineageTag: e7a213a2-4363-45f2-a2f3-6de62cb4b411

	measure 'Txt Pill Nota Atrasado' = FORMAT ( [Nota Atrasado], "0.00" )
		displayFolder: 10 Textos
		lineageTag: b26017f0-701a-47c6-8237-3087b2b0de92

	measure 'Txt KPI Sellers' = FORMAT ( [Sellers], "#,0" )
		displayFolder: 10 Textos
		lineageTag: 4079995a-4aef-4af5-b934-cc75f3cc56e5

	measure 'Txt Ctx Top 10' = "10% maiores = " & FORMAT ( [% Faturamento Top 10%], "0%" ) & " do faturamento"
		displayFolder: 10 Textos
		lineageTag: ba674ae3-719e-490e-98cd-d7e551004584

	measure 'Txt Titulo Contexto' = "O marketplace cresceu " & FORMAT ( [Crescimento Mensal], "0%" ) & " por mês, e os campeões mudam conforme a métrica"
		displayFolder: 10 Textos
		lineageTag: 3b2dbb0b-f8ae-4d68-b0ec-c4ef14f0e42e

	measure 'Txt Titulo Vender' =
			VAR _top20 = TOPN ( 20, FILTER ( VALUES ( dm_seller[seller_id] ), [Faturamento] > 0 ), [Faturamento], DESC )
			VAR _media = [Nota Média]
			VAR _abaixo = COUNTROWS ( FILTER ( _top20, [Nota Média] < _media ) )
			VAR _total = COUNTROWS ( _top20 )
			RETURN
			    IF (
			        _abaixo > 0,
			        _abaixo & " dos " & _total & " sellers que mais faturam têm nota abaixo da média",
			        "Os " & _total & " sellers que mais faturam têm nota acima da média"
			    )
		displayFolder: 10 Textos
		lineageTag: 129bdd03-22b5-4b8f-893d-9d63f0a44080

	measure 'Txt Titulo Nota' =
			"Atrasos são " & FORMAT ( [% Atraso], "0.0%" ) & " dos pedidos, mas geram "
			    & FORMAT ( [% Notas 1 de Atrasos], "0%" ) & " de todas as notas 1"
		displayFolder: 10 Textos
		lineageTag: 2d41e66e-8d88-4b17-baff-5e0333cb5b56

	measure 'Txt Titulo Regiao' =
			VAR _t = FILTER ( ADDCOLUMNS ( VALUES ( dm_cliente_uf[regiao] ), "@prazo", [Prazo Médio], "@atraso", [% Atraso] ), NOT ISBLANK ( [@prazo] ) )
			VAR _pior = TOPN ( 1, _t, [@atraso], DESC )
			VAR _melhor = TOPN ( 1, _t, [@prazo], ASC )
			VAR _nomePior = MAXX ( _pior, dm_cliente_uf[regiao] )
			VAR _prazoPior = MAXX ( _pior, [@prazo] )
			VAR _nomeMelhor = MAXX ( _melhor, dm_cliente_uf[regiao] )
			VAR _razao = DIVIDE ( _prazoPior, MAXX ( _melhor, [@prazo] ) )
			RETURN
			    IF (
			        COUNTROWS ( _t ) <= 1 || _nomePior = _nomeMelhor,
			        "O cliente do " & _nomePior & " espera " & FORMAT ( _prazoPior, "0.0" ) & " dias pela entrega",
			        "O cliente do " & _nomePior & " espera " & FORMAT ( _prazoPior, "0.0" ) & " dias, "
			            & SWITCH ( TRUE (), _razao >= 2.1, "mais que o dobro do ", _razao >= 1.75, "quase o dobro do ", FORMAT ( _razao, "0.0" ) & "× o prazo do " )
			            & _nomeMelhor
			    )
		displayFolder: 10 Textos
		lineageTag: 43ff69c2-c300-40b9-b4ca-f183df6529bf

	measure 'Txt Nota No Prazo' = FORMAT ( [Nota No Prazo], "0.00" )
		displayFolder: 10 Textos
		lineageTag: 6d1c4349-de96-4463-a97c-86118b1993e2

	measure 'Txt Nota Atrasado' = FORMAT ( [Nota Atrasado], "0.00" )
		displayFolder: 10 Textos
