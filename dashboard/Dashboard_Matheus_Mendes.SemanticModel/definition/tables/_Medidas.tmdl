	measure 'Cor Categoria Seller' =
			VAR _max = MAXX ( ALLSELECTED ( dm_categoria[categoria] ), [Faturamento] )
			RETURN IF ( [Faturamento] = _max, "#1A6BF5", "#CFE0FF" )
