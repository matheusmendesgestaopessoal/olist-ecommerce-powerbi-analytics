model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup 00_SOURCE

	annotation PBI_QueryGroupOrder = 0

queryGroup 10_STAGING

	annotation PBI_QueryGroupOrder = 1

queryGroup 20_DIMENSIONS

	annotation PBI_QueryGroupOrder = 2

queryGroup 30_FACTS

	annotation PBI_QueryGroupOrder = 3

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["src_order_items","src_reviews","src_orders","src_category_translation","src_products","src_sellers","stg_orders","stg_order_items","stg_products","stg_category_translation","stg_sellers","stg_reviews","stg_review_order","dm_categoria","dm_seller","dm_data","ft_vendas","ft_avaliacoes_seller","ft_avaliacoes_categoria","_Medidas"]

annotation PBI_ProTooling = ["DevMode"]

ref table dm_categoria
ref table dm_seller
ref table dm_data
ref table ft_vendas
ref table ft_avaliacoes_seller
ref table ft_avaliacoes_categoria
ref table _Medidas
ref table Perspectiva
ref table 'Perspectiva Seller'
ref table 'Eixo Concentracao'

ref cultureInfo pt-BR

